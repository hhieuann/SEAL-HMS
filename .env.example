# ============================================================
# SEAL-HMS — environment template. Copy, DO NOT commit real values.
#   Backend:  cp .env.example backend/.env.properties
#   Frontend: cp .env.example frontend/.env.local   (only VITE_* used)
# ============================================================

# --- Database (PostgreSQL) ---
# If you already run a local PostgreSQL on 5432, set DB_PORT=5433 here AND in
# backend/.env.properties so the Docker DB doesn't clash with the local one.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=seal_hms
DB_USERNAME=postgres
DB_PASSWORD=change_me

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080
