# Java / Maven
target/
*.class
*.jar
# Keep the Maven wrapper committed so teammates can run ./mvnw without a local Maven.
!**/.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.properties

# Env & secrets — NEVER commit real secrets
.env
.env.local
.env.properties
backend/.env.properties
frontend/.env.local
*.local

# Node
node_modules/
dist/
.vite/

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# AI agent / local tooling & git worktrees (never push these)
.claude/
.worktrees/
*.code-workspace
# merge conflict leftovers
*.orig
*.rej

backend/uploads/
debug_event.json

# Local dev helper scripts & scratch notes — keep on your machine, never commit.
# (DB-wipe scripts hardcode local credentials; notes belong in team chat, not the repo.)
clean_db.*
CleanDb.java
seedTeams.js
backend/fetch_tracks.js
backend/data/
*_note.md
*_notes.md
backend_tasks.md
# Root-level Node files only exist to run clean_db.js locally.
# Leading / = repo root only; frontend/package.json is NOT affected.
/package.json
/package-lock.json
